{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "transitcast-cron",
	"main": "worker.js",
	"compatibility_date": "2026-08-14",

	// Same namespace id as the app's wrangler.jsonc — this Worker reads the
	// configs the app writes.
	"kv_namespaces": [
		{
			"binding": "TC_KV",
			"id": "623c08dca01344d98d8aba5be67220ac"
		}
	],

	// Hourly; each user's config carries the UTC hour they want.
	"triggers": {
		"crons": ["0 * * * *"]
	},

	"vars": {
		"APP_ORIGIN": "https://transitcast.workers.dev",
		// Accounts with no app open (no GET /api/config) in this many days have
		// their KV data deleted automatically.
		"INACTIVE_DAYS": "90"
	},

	"observability": {
		"enabled": true
	}

	// Secret (must match the app's): wrangler secret put CRON_SECRET -c cron/wrangler.jsonc
}
